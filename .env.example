# Copy to .env and fill in. Every value here has a working default or a
# documented fallback, the app runs with none of the optional ones set.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local development: run `npx prisma dev --name lifexp` and paste the two
# connection strings it prints. Production: any Postgres URL (Neon, Supabase,
# RDS). The shadow database is only needed to create migrations, not to run them.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google sign-in. Create an OAuth client at console.cloud.google.com and set the
# redirect URI to <AUTH_URL>/api/auth/callback/google.
# Leave both empty in development: the app then offers a local dev sign-in
# instead, so you never need Google credentials just to look at the UI.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# AI extraction (optional, omit entirely to use the rule-based extractor)
# ---------------------------------------------------------------------------
# AI_PROVIDER: "openai" | "anthropic" | "google" | "rules"
# Unset, or set to anything with no matching key, falls back to "rules", which
# needs no network and no key. Chat works either way.
AI_PROVIDER="openai"
AI_API_KEY=""

# Only for AI_PROVIDER=openai. This is the OpenAI-compatible /v1 base URL, so it
# also reaches Groq, OpenRouter, DeepSeek, Together, and a local Ollama:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1
AI_BASE_URL="https://api.openai.com/v1"

# Model id. Sensible picks per provider:
#   openai      gpt-4o-mini
#   anthropic   claude-sonnet-5   (or claude-haiku-4-5 for cheaper extraction)
#   google      gemini-2.5-flash
AI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Google Calendar write-back (optional)
# ---------------------------------------------------------------------------
# Reuses AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET. Nothing extra to configure here,
# users grant calendar access separately from Settings, and LifeXP only ever
# writes to the one calendar it creates.
